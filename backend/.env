# Copy this file to .env and fill in your values

# MongoDB connection string.
# Option 1 (easiest for tomorrow): free MongoDB Atlas cluster
#   -> https://www.mongodb.com/cloud/atlas/register
#   MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/smart-watchlist
# Option 2: local MongoDB running on your machine
#   MONGO_URI=mongodb://127.0.0.1:27017/smart-watchlist
MONGO_URI=mongodb+srv://singharushi912_db_user:godrkph11@cluster0.gixc01m.mongodb.net/smart-watchlist?appName=Cluster0

# Port the backend server runs on
PORT=5000

# How often (ms) the simulated market data engine ticks new prices
PRICE_TICK_INTERVAL_MS=4000
